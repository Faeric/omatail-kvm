#!/usr/bin/env bash
# Checks the relay against the real Wayland clipboard of this machine.
#
# This one does read and change the clipboard: it saves what is there, makes a
# few test copies, and puts the original back. The test copies show up in the
# clipboard history. Use tests/clip-relay-test for everything that can be
# checked without a session.
#
# This machine plays "local": the real watcher and the real receiver, sharing
# one runtime directory as they do once installed. A second receiver on another
# loopback port plays the remote peer, with a wl-copy stand-in that writes to
# files so what arrives there can be compared.

set -uo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
work=$(mktemp -d) || exit 1
pids=()
saved_type=

# wl-copy stays behind to serve what it was given, and keeps the output it was
# started with. Detached from ours, or whatever reads this script's output
# waits on it for as long as the restored copy stays on the clipboard.
restore_clipboard() {
  case "$saved_type" in
  text) wl-copy <"$work/saved" >/dev/null 2>&1 ;;
  image) wl-copy --type image/png <"$work/saved" >/dev/null 2>&1 ;;
  empty) wl-copy --clear >/dev/null 2>&1 ;;
  esac
}

cleanup() {
  local pid
  for pid in "${pids[@]}"; do
    kill "$pid" 2>/dev/null
  done
  restore_clipboard
  rm -rf -- "$work"
}
trap cleanup EXIT

[[ -n ${WAYLAND_DISPLAY:-} ]] || {
  printf 'No Wayland session here; nothing to check.\n' >&2
  exit 2
}

types=$(timeout 2s wl-paste --list-types 2>/dev/null || true)
if grep -qx 'x-kde-passwordManagerHint' <<<"$types"; then
  printf 'The clipboard holds a password manager copy; copy something else and run this again.\n' >&2
  trap 'rm -rf -- "$work"' EXIT
  exit 2
elif grep -qxE 'text/plain(;.*)?|UTF8_STRING|STRING|TEXT' <<<"$types"; then
  saved_type=text
  timeout 5s wl-paste --type text --no-newline >"$work/saved"
elif grep -qx 'image/png' <<<"$types"; then
  saved_type=image
  timeout 10s wl-paste --type image/png >"$work/saved"
else
  saved_type=empty
fi
chmod 600 "$work/saved" 2>/dev/null

mkdir -p "$work"/bin "$work"/{local,remote}/{config,run} "$work/remote/clip"
chmod 700 "$work"/{local,remote}/run
printf '127.0.0.1 loopback\n' | tee "$work/local/config/peers" >"$work/remote/config/peers"

cat >"$work/bin/wl-copy" <<'EOF'
#!/usr/bin/env bash
cat >"$FAKE_CLIP/data.new" && mv "$FAKE_CLIP/data.new" "$FAKE_CLIP/data"
printf '%s\n' "$3" >"$FAKE_CLIP/type"
date +%s%N >>"$FAKE_CLIP/arrivals"
EOF
chmod +x "$work/bin/wl-copy"

local_port=$((20000 + RANDOM % 20000))
remote_port=$((local_port + 1))

passed=0 failed=0
check() {
  local name="$1"
  shift
  if "$@"; then
    passed=$((passed + 1))
    printf '  ok    %s\n' "$name"
  else
    failed=$((failed + 1))
    printf '  FAIL  %s\n' "$name"
  fi
}

arrivals() {
  [[ -e $work/remote/clip/arrivals ]] && wc -l <"$work/remote/clip/arrivals" || echo 0
}

wait_arrivals() {
  local wanted="$1" i
  for i in {1..60}; do
    (($(arrivals) >= wanted)) && return 0
    sleep 0.1
  done
  return 1
}

# Remote peer: fake clipboard.
systemd-socket-activate -l "127.0.0.1:$remote_port" --accept --inetd \
  -E PATH="$work/bin:$PATH" \
  -E OMATAIL_KVM_CONFIG_DIR="$work/remote/config" \
  -E OMATAIL_KVM_RUNTIME_DIR="$work/remote/run" \
  -E FAKE_CLIP="$work/remote/clip" \
  -E REMOTE_ADDR=127.0.0.1 -E HOME -E XDG_RUNTIME_DIR \
  "$root/scripts/clip-receive" >"$work/remote.log" 2>&1 &
pids+=($!)

# Local receiver: the real wl-copy.
systemd-socket-activate -l "127.0.0.1:$local_port" --accept --inetd \
  -E PATH -E WAYLAND_DISPLAY -E XDG_RUNTIME_DIR -E HOME \
  -E OMATAIL_KVM_CONFIG_DIR="$work/local/config" \
  -E OMATAIL_KVM_RUNTIME_DIR="$work/local/run" \
  -E REMOTE_ADDR=127.0.0.1 \
  "$root/scripts/clip-receive" >"$work/local.log" 2>&1 &
pids+=($!)

# Local watcher: the real wl-paste, exactly as the service runs it.
OMATAIL_KVM_CONFIG_DIR="$work/local/config" OMATAIL_KVM_RUNTIME_DIR="$work/local/run" OMATAIL_KVM_CLIP_PORT="$remote_port" \
  "$root/scripts/clip-watch" >"$work/watch.log" 2>&1 &
pids+=($!)

for port in "$local_port" "$remote_port"; do
  for _ in {1..50}; do
    [[ $(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$port/ping") == 204 ]] && break
    sleep 0.1
  done
done
sleep 0.5

# wl-paste --watch runs the command once for the clipboard as it stands at
# startup, so the saved content may reach the fake remote first. Start counting
# from whatever has settled.
sleep 1
base=$(arrivals)

printf 'Copies made here leave for the peer\n'

text="omatail-kvm smoke test $(date +%H:%M:%S) é√"
printf '%s' "$text" | wl-copy
check "a text copy is picked up by the watcher" wait_arrivals $((base + 1))
check "it arrives unchanged" test "$(cat "$work/remote/clip/data" 2>/dev/null)" = "$text"
check "it arrives as text" grep -qx 'text/plain;charset=utf-8' "$work/remote/clip/type"

base64 -d >"$work/pixel.png" <<<'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg=='
wl-copy --type image/png <"$work/pixel.png"
check "an image-only copy is picked up by the watcher" wait_arrivals $((base + 2))
check "the image arrives unchanged" cmp -s "$work/pixel.png" "$work/remote/clip/data"
check "it arrives as image/png" grep -qx 'image/png' "$work/remote/clip/type"

printf 'first' | wl-copy
printf 'second' | wl-copy
printf 'third' | wl-copy
wait_arrivals $((base + 3))
sleep 1.5
check "quick successive copies end on the last one" test "$(cat "$work/remote/clip/data")" = 'third'

printf 'Clips from the peer land here and are not sent back\n'

post() {
  curl -s -o /dev/null -w '%{http_code}' --max-time 10 --noproxy '*' \
    -H 'Expect:' -H "Content-Type: $1" -H "X-Omatail-Kvm-Sha256: $(sha256sum <"$2" | cut -d' ' -f1)" \
    --data-binary "@$2" "http://127.0.0.1:$local_port/clip"
}

settled=$(arrivals)
incoming="from the peer $(date +%H:%M:%S) ü"
printf '%s' "$incoming" >"$work/incoming"
check "the receiver accepts a text clip" test "$(post 'text/plain;charset=utf-8' "$work/incoming")" = 204
sleep 1
check "the clipboard now holds it" test "$(timeout 2s wl-paste --type text --no-newline)" = "$incoming"
check "it is offered as ordinary text" bash -c 'timeout 2s wl-paste --list-types | grep -qx "text/plain"'
sleep 1.5
check "the received text was not sent back" test "$(arrivals)" = "$settled"

check "the receiver accepts an image clip" test "$(post image/png "$work/pixel.png")" = 204
sleep 1
timeout 5s wl-paste --type image/png >"$work/pasted.png" 2>/dev/null
check "the clipboard now holds the image" cmp -s "$work/pixel.png" "$work/pasted.png"
sleep 1.5
check "the received image was not sent back" test "$(arrivals)" = "$settled"

printf '\n%d passed, %d failed\n' "$passed" "$failed"
if ((failed)); then
  printf '\n--- watcher log\n'
  cat "$work/watch.log"
  printf -- '--- local receiver log\n'
  cat "$work/local.log"
  printf -- '--- remote receiver log\n'
  cat "$work/remote.log"
fi
((failed == 0))
