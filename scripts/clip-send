#!/usr/bin/env bash
# Push one clipboard change to every peer.
#
# Usage: clip-send text|image/png    (the copy itself arrives on stdin)
#
# Run by `wl-paste --type <type> --watch` on each clipboard change. wl-paste
# hands over the bytes of that change on stdin together with CLIPBOARD_STATE,
# and those bytes are the only ones ever sent: the clipboard is not read a
# second time, so what is sent is exactly what the state describes.

set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib.sh"

case "${1:-}" in
text) mime="$MIME_TEXT" ;;
"$MIME_PNG") mime="$MIME_PNG" ;;
*)
  printf 'Usage: clip-send text|%s  (the copy on stdin)\n' "$MIME_PNG" >&2
  exit 2
  ;;
esac

# wl-paste marks copies a password manager flagged as secret, and tells an
# emptied clipboard apart from a real copy. Neither is ever read or sent.
case "${CLIPBOARD_STATE:-data}" in
sensitive | nil | clear) exit 0 ;;
esac

paused() {
  [[ -e $PAUSE_FILE ]]
}

paused && exit 0

mapfile -t peers < <(peer_addresses)
((${#peers[@]})) || exit 0

ensure_runtime_dir || {
  log "clip-send: runtime directory $OMATAIL_KVM_RUNTIME_DIR is not usable"
  exit 1
}

payload=$(mktemp -- "$OMATAIL_KVM_RUNTIME_DIR/clip-out.XXXXXX") || exit 1
trap 'rm -f -- "$payload"' EXIT

# The owner streams the copy and can stall, so the read is bounded; a copy cut
# off at the deadline is dropped rather than sent truncated. One byte past the
# limit is enough to know the copy is too large.
timeout 10s head -c "$((OMATAIL_KVM_CLIP_MAX_BYTES + 1))" >"$payload" 2>/dev/null || exit 0

size=$(stat -c %s -- "$payload") || exit 1
((size > 0)) || exit 0
if ((size > OMATAIL_KVM_CLIP_MAX_BYTES)); then
  log "clip-send: skipped a copy over the $OMATAIL_KVM_CLIP_MAX_BYTES byte limit"
  exit 0
fi

# The types on offer are looked at only to decide to stay silent, never to
# choose what to read. A secret hint means nothing is sent. Plain text wins
# over a picture of it: a spreadsheet offers an image of the cells next to
# their text, the text watcher sends the text, and this one lets it.
types=$(timeout 2s wl-paste --list-types 2>/dev/null) || types=
grep -qx 'x-kde-passwordManagerHint' <<<"$types" && exit 0
if [[ $mime == "$MIME_PNG" ]] && grep -qxE 'text/plain(;.*)?|UTF8_STRING|STRING|TEXT' <<<"$types"; then
  exit 0
fi

# One send at a time, so two quick copies arrive in the order they were made.
exec 9>"$OMATAIL_KVM_RUNTIME_DIR/clip-send.lock"
flock -w 30 9 || exit 0

# Syncing may have been paused while this copy waited its turn.
paused && exit 0

sha=$(sha256_file "$payload") || exit 1
[[ $sha == "$(synced_sha)" ]] && exit 0

push() {
  curl --silent --show-error --fail --noproxy '*' \
    --connect-timeout 3 --max-time 60 \
    -H 'Expect:' -H "Content-Type: $mime" -H "X-Omatail-Kvm-Sha256: $sha" \
    --data-binary "@$payload" --output /dev/null \
    "http://$1:$OMATAIL_KVM_CLIP_PORT/clip"
}

delivered=0
for peer in "${peers[@]}"; do
  paused && break
  if error=$(push "$peer" 2>&1); then
    delivered=1
    record_transfer out "$mime" "$size" "$peer"
    log "clip-send: sent $mime ($size bytes) to $peer"
  else
    log "clip-send: $peer did not take the clip: $(printable "$error")"
  fi
done

# Recorded only once a peer confirmed it, so a copy made while every peer was
# away is sent the next time it is copied.
((delivered)) && mark_synced "$sha"

exit 0
