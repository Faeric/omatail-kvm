#!/usr/bin/env bash
# Install, remove or inspect the clipboard relay's systemd user units.
#
# Usage: clip-service install | uninstall | status
#
# Three units, all in the user manager, so nothing here needs root:
#
#   omakvm-clip.socket          listens for clips from the peers
#   omakvm-clip@.service        handles one incoming clip (clip-receive)
#   omakvm-clip-watch.service   watches this clipboard and sends (clip-watch)
#
# The units point at the scripts next to this one, so `install` is run again
# whenever the scripts move.

set -uo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
source "$here/lib.sh"

unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
socket_unit=omakvm-clip.socket
receive_unit=omakvm-clip@.service
watch_unit=omakvm-clip-watch.service

install_units() {
  mkdir -p -- "$unit_dir" || return 1

  # Bound to IPv4 so REMOTE_ADDR arrives as a plain address, the form the
  # peers file uses. The firewall decides which interface may reach it.
  cat >"$unit_dir/$socket_unit" <<EOF
[Unit]
Description=Omakvm clipboard relay: incoming clips

[Socket]
ListenStream=0.0.0.0:$OMAKVM_CLIP_PORT
Accept=yes
MaxConnections=16
NoDelay=true

[Install]
WantedBy=sockets.target
EOF

  # Each instance becomes the wl-copy that serves the clip it received, and
  # ends when the next copy replaces it.
  cat >"$unit_dir/$receive_unit" <<EOF
[Unit]
Description=Omakvm clipboard relay: one incoming clip
CollectMode=inactive-or-failed

[Service]
ExecStart=$here/clip-receive
StandardInput=socket
StandardOutput=socket
StandardError=journal
EOF

  cat >"$unit_dir/$watch_unit" <<EOF
[Unit]
Description=Omakvm clipboard relay: outgoing clips
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=$here/clip-watch
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
EOF

  systemctl --user daemon-reload || return 1
  systemctl --user enable --quiet "$socket_unit" "$watch_unit" || return 1
  # Restarted rather than started, so a reinstall picks up moved scripts.
  systemctl --user restart "$socket_unit" "$watch_unit"
}

uninstall_units() {
  systemctl --user disable --now --quiet "$socket_unit" "$watch_unit" 2>/dev/null
  # Instances still holding a received clip would keep the old script alive.
  systemctl --user stop 'omakvm-clip@*.service' 2>/dev/null
  rm -f -- "$unit_dir/$socket_unit" "$unit_dir/$receive_unit" "$unit_dir/$watch_unit"
  systemctl --user daemon-reload
}

show_status() {
  local peer last when direction mime size from
  printf 'incoming  %s\n' "$(systemctl --user is-active "$socket_unit" 2>/dev/null)"
  printf 'outgoing  %s\n' "$(systemctl --user is-active "$watch_unit" 2>/dev/null)"
  printf 'paused    %s\n' "$([[ -e $PAUSE_FILE ]] && echo yes || echo no)"

  while read -r peer; do
    if curl --silent --fail --noproxy '*' --connect-timeout 2 --max-time 4 \
      --output /dev/null "http://$peer:$OMAKVM_CLIP_PORT/ping" 2>/dev/null; then
      printf 'peer      %s reachable\n' "$peer"
    else
      printf 'peer      %s not answering\n' "$peer"
    fi
  done < <(peer_addresses)

  if [[ -r $LAST_FILE ]] && read -r when direction mime size from <"$LAST_FILE"; then
    printf 'last      %s %s, %s bytes, %s %s, %s\n' \
      "$direction" "$mime" "$size" "$([[ $direction == in ]] && echo from || echo to)" "$from" \
      "$(date -d "@$when" +%H:%M:%S)"
  fi
}

case "${1:-}" in
install)
  install_units || {
    log "clip-service: installing the units failed"
    exit 1
  }
  show_status
  ;;
uninstall)
  uninstall_units
  ;;
status)
  show_status
  ;;
*)
  printf 'Usage: clip-service install | uninstall | status\n' >&2
  exit 2
  ;;
esac
